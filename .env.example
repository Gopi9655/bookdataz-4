# =============================================================================
# BookDataZ — environment variables (example)
# Copy to .env.local and fill in real values. NEVER commit real secrets.
# =============================================================================

# --- Database (server-side, SECRET — do not expose to the client) -----------
# Neon Postgres connection string. Used by the contact API and admin dashboard.
# The contact_submissions table is created automatically on first use.
DATABASE_URL=

# --- Captcha mode -----------------------------------------------------------
# Controls whether the contact form requires captcha verification.
#   "off"       -> no captcha widget, API does not require a token (current).
#   "recaptcha" -> frontend renders reCAPTCHA, API verifies it server-side.
CONTACT_CAPTCHA_MODE=off

# --- reCAPTCHA (only needed when CONTACT_CAPTCHA_MODE=recaptcha) -------------
# Public site key (client-side, safe to expose):
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Secret key (server-side, SECRET — never expose to the client):
RECAPTCHA_SECRET_KEY=

# --- Admin dashboard (server-side, SECRET) ----------------------------------
# Password for /admin/submissions.
ADMIN_DASHBOARD_PASSWORD=
# Long random salt used to hash submitter IPs and the admin session cookie.
ADMIN_IP_HASH_SALT=choose-a-long-random-salt
