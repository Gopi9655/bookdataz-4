# =============================================================================
# BookDataZ — environment variables (example)
# Copy to .env.local and fill in real values. NEVER commit real secrets.
# =============================================================================

# --- Public reCAPTCHA site key (client-side, safe to expose) ----------------
# Used by the contact form (react-google-recaptcha).
# For LOCAL preview, the contact form falls back to a bundled production key,
# but Google reCAPTCHA will only validate it on domains allowed in the
# reCAPTCHA admin console. To test the captcha on localhost either:
#   1) create your own reCAPTCHA v2 key and add `localhost` / `127.0.0.1` to
#      the allowed domains, then set it below, OR
#   2) use a Google reCAPTCHA test key (always passes; never use in prod).
# Leaving this unset shows a dev-only hint on /contact (production unaffected).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Database (server-side, SECRET — do not expose to the client) -----------
# Connection string for the contact submission store. Required only if you run
# the /api/contact handler locally.
NEON_DB_URL=
